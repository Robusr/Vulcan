# Vulcan server configuration
# Copy this file to .env and fill in your provider details.
# Never commit .env.

# The QINIU_* names are historical (the first deployment used Qiniu Cloud).
# The client is OpenAI-compatible: any provider that exposes
# POST {QINIU_BASE_URL}/chat/completions works.

QINIU_API_KEY="sk-xxxxxxxxxxxxxxxx"
QINIU_BASE_URL="https://api.openai.com/v1"
QINIU_MODEL="gpt-4o-mini"

# Server binding. Keep 127.0.0.1 unless a trusted reverse proxy sits in front.
HOST="127.0.0.1"
PORT="5000"
FLASK_ENV="production"

# Optional bearer token. If set, clients must send:
#   Authorization: Bearer <VULCAN_API_TOKEN>
VULCAN_API_TOKEN=""

# Per-IP limit for /api/v1/generate. Set 0 to disable.
VULCAN_RATE_LIMIT_PER_MINUTE="60"

# Request limits and provider timeout.
MAX_PROMPT_LENGTH="4000"
LLM_TIMEOUT="30"

# BYOK (bring-your-own-key). Clients may send X-LLM-API-Key / X-LLM-Base-URL /
# X-LLM-Model headers to override the server's provider on a per-request basis.
# Set to false to force all clients to use the server-side QINIU_* settings.
VULCAN_ALLOW_CUSTOM_LLM_BASE_URL="true"
MAX_LLM_API_KEY_LENGTH="512"
MAX_LLM_BASE_URL_LENGTH="512"

# Logging. Logs are rotated and must stay out of git.
LOG_LEVEL="INFO"
LOG_FILE="vulcan_server.log"
