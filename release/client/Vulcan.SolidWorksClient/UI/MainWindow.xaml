<Window
    x:Class="Vulcan.SolidWorksClient.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vulcan AI For SolidWorks"
    Width="520"
    Height="320"
    Background="#F1F5F9"
    FontFamily="Microsoft YaHei UI"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#EA580C" />
            <GradientStop Offset="1" Color="#F97316" />
        </LinearGradientBrush>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="12,4"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            VerticalAlignment="Center"
            FontSize="15"
            FontWeight="Bold"
            Foreground="#0F172A"
            Text="输入建模需求" />

        <!--  输入卡片  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="10"
            Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                x:Name="PromptTextBox"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                FontSize="12.5"
                Foreground="#0F172A"
                GotFocus="PromptTextBox_GotFocus"
                LostFocus="PromptTextBox_LostFocus"
                Text="例如：在前视基准面拉伸一个直径50，高度100圆柱体"
                TextWrapping="Wrap"
                ToolTip="例如：在前视基准面拉伸一个直径50，高度100圆柱体"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <!--  生成按钮  -->
        <Button
            x:Name="GenerateBtn"
            Grid.Row="2"
            Height="42"
            Margin="0,0,0,10"
            Click="GenerateBtn_Click"
            Content="开始生成"
            Style="{StaticResource AccentButton}" />

        <!--  状态行  -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal">
            <Ellipse
                Width="8"
                Height="8"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Fill="#10B981" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#64748B"
                Text="就绪" />
        </StackPanel>
    </Grid>
</Window>
