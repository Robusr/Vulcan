<UserControl
    x:Class="Vulcan.SolidWorksClient.UI.TaskPanePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{DynamicResource PageBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vulcan.SolidWorksClient;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="#0A0A0A"
                    CornerRadius="8">
                    <Grid>
                        <Path
                            Data="M8 7 L16 24 L24 7"
                            Stroke="White"
                            StrokeThickness="2.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round" />
                        <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,5,4,0"
                            Fill="{StaticResource AccentBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Vulcan AI" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="自然语言生成 SolidWorks 特征"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="SettingsBtn"
                    Grid.Column="3"
                    AutomationProperties.Name="设置"
                    Click="SettingsBtn_Click"
                    Content="&#xE713;"
                    Style="{StaticResource IconButton}"
                    ToolTip="配置服务端和模型提供商" />
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <Button
                    Margin="0,0,6,6"
                    Click="CylinderExample_Click"
                    Content="圆柱示例"
                    Style="{StaticResource ChipButton}" />
                <Button
                    Margin="0,0,6,6"
                    Click="PlateExample_Click"
                    Content="安装板示例"
                    Style="{StaticResource ChipButton}" />
                <Button
                    Margin="0,0,6,6"
                    Click="TestConnection_Click"
                    Content="测试连接"
                    Style="{StaticResource ChipButton}" />
                <Button
                    Margin="0,0,6,6"
                    Click="Status_Click"
                    Content="运行状态"
                    Style="{StaticResource ChipButton}" />
                <Button
                    Margin="0,0,6,6"
                    Click="Logs_Click"
                    Content="日志"
                    Style="{StaticResource ChipButton}" />
            </WrapPanel>

            <TextBlock
                Margin="0,12,0,6"
                Style="{StaticResource FieldLabel}"
                Text="建模需求" />

            <TextBox
                x:Name="PromptTextBox"
                Height="170"
                AcceptsReturn="True"
                AutomationProperties.Name="建模需求"
                Background="{StaticResource CardBrush}"
                FontSize="12.5"
                Style="{StaticResource RoundedTextBox}"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto" />

            <Button
                x:Name="GenerateBtn"
                Margin="0,10,0,0"
                MinHeight="36"
                Click="GenerateBtn_Click"
                Content="开始生成"
                Style="{StaticResource PrimaryButton}" />

            <TextBlock
                x:Name="StatusText"
                Margin="0,8,0,0"
                Style="{StaticResource CaptionText}"
                Text="就绪"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
