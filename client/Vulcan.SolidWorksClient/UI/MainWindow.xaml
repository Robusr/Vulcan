<Window
    x:Class="Vulcan.SolidWorksClient.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vulcan AI"
    Width="680"
    Height="520"
    MinWidth="600"
    MinHeight="460"
    Background="{DynamicResource PageBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vulcan.SolidWorksClient;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="44"
                Height="44"
                Background="{StaticResource BrandGradient}"
                CornerRadius="10">
                <Grid>
                    <Path
                        Data="M11 10 L22 34 L33 10"
                        Stroke="White"
                        StrokeThickness="4"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,7,6,0"
                        Fill="{StaticResource AccentBrush}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Vulcan AI" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource MutedText}"
                    Text="用自然语言生成参数化 SolidWorks 特征" />
            </StackPanel>

            <Button
                x:Name="SettingsBtn"
                Grid.Column="3"
                AutomationProperties.Name="设置"
                Click="SettingsBtn_Click"
                Content="&#xE713;"
                Style="{StaticResource IconButton}"
                ToolTip="配置服务端、Token 和模型提供商" />
        </Grid>

        <!--  Prompt card  -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="描述你的零件" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource MutedText}"
                            Text="包含基准面、形状、尺寸和特征顺序，模型会返回可编辑的 JSON。" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CharCountText"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource CaptionText}"
                        Text="0 / 4000" />
                </Grid>

                <Grid Grid.Row="2">
                    <TextBox
                        x:Name="PromptTextBox"
                        MinHeight="150"
                        AutomationProperties.Name="建模需求"
                        AcceptsReturn="True"
                        Background="#FAFAFA"
                        FontSize="13.5"
                        MaxLength="4000"
                        Style="{StaticResource RoundedTextBox}"
                        TextChanged="PromptTextBox_TextChanged"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        x:Name="PlaceholderText"
                        Margin="13,11,13,11"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        FontSize="13.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="例如：在前视基准面拉伸一个直径 50、高度 100 的圆柱体"
                        TextWrapping="Wrap" />
                </Grid>

                <WrapPanel
                    x:Name="ExamplePanel"
                    Grid.Row="4"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="圆柱示例"
                        Click="ExampleChip_Click"
                        Content="圆柱示例"
                        Style="{StaticResource ChipButton}"
                        Tag="在前视基准面拉伸一个直径 50、高度 100 的圆柱体" />
                    <Button
                        AutomationProperties.Name="安装板示例"
                        Click="ExampleChip_Click"
                        Content="安装板示例"
                        Style="{StaticResource ChipButton}"
                        Tag="在前视基准面拉伸 200×100×20 的安装板，四角各打一个直径 10mm 的通孔" />
                    <Button
                        AutomationProperties.Name="圆角示例"
                        Click="ExampleChip_Click"
                        Content="圆角示例"
                        Style="{StaticResource ChipButton}"
                        Tag="给当前零件的所有边添加 3mm 圆角" />
                </WrapPanel>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="GenerateBtn"
                        AutomationProperties.Name="开始生成"
                        Click="GenerateBtn_Click"
                        Content="开始生成"
                        Style="{StaticResource PrimaryButton}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="Ctrl + Enter" />
                </Grid>
            </Grid>
        </Border>

        <!--  Status  -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="4"
            Background="{StaticResource SuccessBgBrush}"
            BorderBrush="{StaticResource SuccessBorderBrush}"
            Style="{StaticResource StatusBanner}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Name="StatusIcon"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Foreground="{StaticResource SuccessBrush}"
                    Text="&#xE73E;" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SuccessBrush}"
                    Text="就绪"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ProgressBar
            x:Name="BusyBar"
            Grid.Row="5"
            Height="3"
            Margin="0,8,0,0"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{StaticResource AccentBrush}"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource CaptionText}"
                Text="支持拉伸、切除、旋转、阵列、镜像、抽壳、拔模、扫掠、放样和筋" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource CaptionText}"
                Text="Vulcan 1.2.1" />
        </Grid>
    </Grid>
</Window>
