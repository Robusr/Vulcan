<Window
    x:Class="Vulcan.SolidWorksClient.UI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="检查并编辑建模参数"
    Width="900"
    Height="680"
    MinWidth="760"
    MinHeight="560"
    Background="{DynamicResource PageBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vulcan.SolidWorksClient;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="检查并编辑建模参数" />
                <TextBlock
                    x:Name="PromptText"
                    Margin="0,6,0,0"
                    Style="{StaticResource MutedText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <Border
                Grid.Column="1"
                Padding="10,4"
                VerticalAlignment="Top"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource BusyBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <TextBlock
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AccentDarkBrush}"
                    Text="可编辑 JSON" />
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="{StaticResource DarkEditorBrush}"
            BorderBrush="{StaticResource DarkEditorBorderBrush}"
            Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="12,8"
                    Background="{StaticResource DarkEditorToolbarBrush}"
                    CornerRadius="12,12,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DarkEditorTextBrush}"
                                Text="JSON 特征树" />
                            <TextBlock
                                x:Name="ValidationHint"
                                Margin="10,0,0,0"
                                FontSize="11.5"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="JSON 有效" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Content="格式化"
                                Click="FormatBtn_Click"
                                Style="{StaticResource DarkToolbarButton}" />
                            <Button
                                Content="恢复原始"
                                Click="ResetBtn_Click"
                                Style="{StaticResource DarkToolbarButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox
                    x:Name="JsonEditor"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{StaticResource AccentBrush}"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    Foreground="{StaticResource DarkEditorTextBrush}"
                    HorizontalScrollBarVisibility="Auto"
                    Padding="14"
                    SelectionBrush="{StaticResource AccentBrush}"
                    SelectionOpacity="0.35"
                    SpellCheck.IsEnabled="False"
                    TextChanged="JsonEditor_TextChanged"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Border
            x:Name="ValidationBanner"
            Grid.Row="4"
            Background="{StaticResource ErrorBgBrush}"
            BorderBrush="{StaticResource ErrorBorderBrush}"
            Style="{StaticResource StatusBanner}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Name="ValidationIcon"
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Foreground="{StaticResource ErrorBrush}"
                    Text="&#xE711;" />
                <TextBlock
                    x:Name="ValidationText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource ErrorBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="执行前会检查特征类型、必填字段和数值范围。" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click"
                    Content="取消"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    x:Name="ExecuteBtn"
                    IsEnabled="False"
                    Width="140"
                    Click="ExecuteBtn_Click"
                    Content="执行建模"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
